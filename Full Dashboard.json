    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Dashboard - Customer, Supplier, and Stock Analytics</title>\n  <style>\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\";\n      font-size: 9pt;\n      margin: 20px;\n      background-color: #f5f5f5;\n      {{ $json.data[3].cssBackground }}\n    }\n    \n    h2 {\n      color: #333;\n      margin-top: 0;\n      margin-bottom: 20px;\n      text-align: center;\n      font-size: 18px;\n      font-weight: 600;\n    }\n    \n    .chart-panel {\n      background-color: #ffffff;\n      border-radius: 8px;\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n      padding: 20px;\n    }\n    \n    .top-charts-container {\n      display: flex;\n      gap: 20px;\n      margin-bottom: 20px;\n    }\n    \n    .chart-wrapper {\n      flex: 1;\n      min-width: 0;\n    }\n    \n    .chart-wrapper-full {\n      width: 100%;\n    }\n    \n    #customerTransactionsChart {\n      width: 100%;\n      height: 400px;\n    }\n    \n    #supplierTransactionsChart {\n      width: 100%;\n      height: 400px;\n    }\n    \n    #stockLocationsChart {\n      width: 100%;\n      height: 600px;\n    }\n  </style>\n</head>\n<body>\n  \n  <div class=\"top-charts-container\">\n    <div class=\"chart-wrapper\">\n      <div class=\"chart-panel\">\n        <h2>Customer Transactions by Month</h2>\n        <div id=\"customerTransactionsChart\"></div>\n      </div>\n    </div>\n    \n    <div class=\"chart-wrapper\">\n      <div class=\"chart-panel\">\n        <h2>Supplier Transactions</h2>\n        <div id=\"supplierTransactionsChart\"></div>\n      </div>\n    </div>\n  </div>\n  \n  <div class=\"chart-wrapper-full\">\n    <div class=\"chart-panel\">\n      <h2>Stock Item Locations</h2>\n      <div id=\"stockLocationsChart\"></div>\n    </div>\n  </div>\n  \n  <!-- AmCharts Scripts -->\n  <script src=\"//cdn.amcharts.com/lib/4/core.js\"></script>\n  <script src=\"//cdn.amcharts.com/lib/4/charts.js\"></script>\n  <script src=\"//cdn.amcharts.com/lib/4/themes/animated.js\"></script>\n  <script src=\"//cdn.amcharts.com/lib/4/themes/kelly.js\"></script>\n  <script src=\"//cdn.amcharts.com/lib/4/plugins/forceDirected.js\"></script>\n  \n  <script>\n    // Apply chart themes globally\n    am4core.useTheme(am4themes_animated);\n    am4core.useTheme(am4themes_kelly);\n    \n    // ========================================\n    // CUSTOMER TRANSACTIONS CHART (XY Column)\n    // ========================================\n    \n    // Create chart instance\n    var customerTransactionsChart = am4core.create(\"customerTransactionsChart\", am4charts.XYChart);\n    \n    // Add data\n    customerTransactionsChart.data = {{ $json.data[0].customerTransactions.toJsonString() }}\n    \n    // Create axes\n    var customerTransactionsCategoryAxis = customerTransactionsChart.xAxes.push(new am4charts.CategoryAxis());\n    customerTransactionsCategoryAxis.dataFields.category = \"MonthName\";\n    customerTransactionsCategoryAxis.title.text = \"Month\";\n    customerTransactionsCategoryAxis.renderer.grid.template.location = 0;\n    customerTransactionsCategoryAxis.renderer.minGridDistance = 20;\n    \n    var customerTransactionsValueAxis = customerTransactionsChart.yAxes.push(new am4charts.ValueAxis());\n    customerTransactionsValueAxis.title.text = \"Transaction Amount ($)\";\n    \n    // Create series\n    var customerTransactionsSeries = customerTransactionsChart.series.push(new am4charts.ColumnSeries());\n    customerTransactionsSeries.dataFields.valueY = \"TotalTransactionAmount\";\n    customerTransactionsSeries.dataFields.categoryX = \"MonthName\";\n    customerTransactionsSeries.name = \"Customer Transactions\";\n    customerTransactionsSeries.tooltipText = \"{name}: [bold]${valueY.formatNumber('#,###.00')}[/]\";\n    customerTransactionsSeries.columns.template.fill = am4core.color(\"#67b7dc\");\n    \n    // Add cursor\n    customerTransactionsChart.cursor = new am4charts.XYCursor();\n    \n    \n    // ========================================\n    // SUPPLIER TRANSACTIONS CHART (Pie)\n    // ========================================\n    \n    // Create chart instance\n    var supplierTransactionsChart = am4core.create(\"supplierTransactionsChart\", am4charts.PieChart);\n    \n    // Add data\n    supplierTransactionsChart.data = {{ $json.data[1].supplierTransactions.toJsonString() }}\n    \n    // Add and configure Series\n    var supplierPieSeries = supplierTransactionsChart.series.push(new am4charts.PieSeries());\n    supplierPieSeries.dataFields.value = \"TotalTransactionAmount\";\n    supplierPieSeries.dataFields.category = \"SupplierName\";\n    \n    // Configure labels to show percentages\n    supplierPieSeries.labels.template.text = \"{category}: {value.percent.formatNumber('#.0')}%\";\n    \n    // Configure tooltips to show currency\n    supplierPieSeries.slices.template.tooltipText = \"{category}: [bold]${value.formatNumber('#,###.00')}[/]\";\n    supplierTransactionsChart.innerRadius = am4core.percent(40);\n    \n    supplierPieSeries.slices.template.stroke = am4core.color(\"#4a2abb\");\n    supplierPieSeries.slices.template.strokeWidth = 2;\n    supplierPieSeries.slices.template.strokeOpacity = 1;\n    \n    // Add a legend\n    supplierTransactionsChart.legend = new am4charts.Legend();\n    \n    \n    // ========================================\n    // STOCK LOCATIONS CHART (Force Directed)\n    // ========================================\n    \n    // Create chart\n    var stockLocationsChart = am4core.create(\"stockLocationsChart\", am4plugins_forceDirected.ForceDirectedTree);\n    \n    // Create series\n    var stockLocationsSeries = stockLocationsChart.series.push(new am4plugins_forceDirected.ForceDirectedSeries());\n    \n    // Original data\n    var stockData = {{ $json.data[2].stockLocations.toJsonString() }}\n    \n    // Group data by location prefix\n    var groupedStockData = {};\n    stockData.forEach(function(item) {\n      var prefix = item.BinLocation.split('-')[0];\n      if (!groupedStockData[prefix]) {\n        groupedStockData[prefix] = [];\n      }\n      groupedStockData[prefix].push({\n        name: item.BinLocation,\n        value: item.TotalQuantityOnHand\n      });\n    });\n    \n    // Convert to hierarchical format\n    var hierarchicalStockData = [];\n    for (var prefix in groupedStockData) {\n      hierarchicalStockData.push({\n        name: \"Zone \" + prefix,\n        children: groupedStockData[prefix]\n      });\n    }\n    \n    // Set data\n    stockLocationsSeries.data = hierarchicalStockData;\n    \n    // Set up data fields\n    stockLocationsSeries.dataFields.value = \"value\";\n    stockLocationsSeries.dataFields.name = \"name\";\n    stockLocationsSeries.dataFields.children = \"children\";\n    \n    // Add labels\n    stockLocationsSeries.nodes.template.label.text = \"{name}\";\n    stockLocationsSeries.fontSize = 9;\n    stockLocationsSeries.minRadius = 20;\n    stockLocationsSeries.maxRadius = 60;\n    stockLocationsSeries.centerStrength = 0.5;\n    \n    // Configure tooltips\n    stockLocationsSeries.nodes.template.tooltipText = \"{name}: [bold]{value.formatNumber('#,###')}[/] units\";\n    \n    // Make nodes draggable\n    stockLocationsSeries.nodes.template.draggable = true;\n  </script>\n  \n</body>\n</html>"
      },
