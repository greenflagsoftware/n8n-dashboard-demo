          "id": "AtQQde4iygfxummY",
          "name": "Wide World Importers"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    s.SupplierName,\n    SUM(st.TransactionAmount) AS TotalTransactionAmount\nFROM [WideWorldImporters].[Purchasing].[SupplierTransactions] st\nINNER JOIN [WideWorldImporters].[Purchasing].[Suppliers] s\n    ON st.SupplierID = s.SupplierID\nWHERE st.TransactionAmount > 0\nGROUP BY s.SupplierID, s.SupplierName\nORDER BY s.SupplierName;"
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.1,
      "position": [
