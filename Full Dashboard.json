    {
      "parameters": {
        "jsCode": "// Get the binary data from the input\nconst items = $input.all();\n\n// Process each item\nreturn items.map(item => {\n  // Get the binary data (assuming it's in the default 'data' field)\n  const binaryData = item.binary.data;\n  \n  // Convert buffer to base64\n  const base64String = binaryData.data;\n  \n  // Create the data URI for CSS usage\n  const mimeType = binaryData.mimeType || 'image/png';\n  const dataUri = `data:${mimeType};base64,${base64String}`;\n  \n  // Return the item with the base64 string\n  return {\n    json: {\n      base64: base64String,\n      dataUri: dataUri,\n      cssBackground: `background-image: url('${dataUri}');`\n    }\n  };\n});"
      },
