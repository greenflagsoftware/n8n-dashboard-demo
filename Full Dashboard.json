    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    MONTH(TransactionDate) AS MonthNumber,\n    DATENAME(MONTH, TransactionDate) AS MonthName,\n    SUM(TransactionAmount) AS TotalTransactionAmount\nFROM [WideWorldImporters].[Reports].[CustomerTransactionsView]\nWHERE YEAR(TransactionDate) = 2016\n    AND TransactionAmount > 0\nGROUP BY MONTH(TransactionDate), DATENAME(MONTH, TransactionDate)\nORDER BY MONTH(TransactionDate);"
      },
      "type": "n8n-nodes-base.microsoftSql",
      "typeVersion": 1.1,
      "position": [
        -880,
        -224
      ],
      "id": "2ff5edd9-8c2b-487d-b119-98a861acf369",
      "name": "Microsoft SQL - Customer Transactions",
      "credentials": {
