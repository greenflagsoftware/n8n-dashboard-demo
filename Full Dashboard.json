    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    BinLocation,\n    SUM(QuantityOnHand) AS TotalQuantityOnHand\nFROM [WideWorldImporters].[Warehouse].[StockItemHoldings]\nWHERE YEAR(LastEditedWhen) = 2016\nGROUP BY BinLocation\nORDER BY BinLocation;"
      },
